# Copy to .env (never commit .env). Values below are for local development only.

DJANGO_SECRET_KEY=change-me-local-dev-only
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# PostgreSQL. Create the role and database once with scripts/create_dev_db.sql.
DATABASE_URL=postgres://simb:simb_local_dev@localhost:5432/simb

# Where submissions and generated files are stored (default: <repo>/storage).
# SIMB_STORAGE_ROOT=
