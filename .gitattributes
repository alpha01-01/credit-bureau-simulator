# Use LF line endings in the repository and the working tree on every
# platform. Shell scripts (e.g. .githooks/pre-commit) break with CRLF.
* text=auto eol=lf

# Windows-only scripts keep CRLF.
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Binary assets
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.webp binary
*.glb binary
*.xlsx binary
*.pdf binary
